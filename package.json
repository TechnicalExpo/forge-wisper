{
  "name": "forge-wisper-monorepo",
  "version": "0.3.7",
  "private": true,
  "description": "Open-Source AI Voice-to-Text and Smart Writing Desktop Application",
  "scripts": {
    "dev": "pnpm --filter @forge-wisper/desktop dev",
    "build": "pnpm --filter @forge-wisper/desktop build",
    "tauri": "pnpm --filter @forge-wisper/desktop tauri",
    "tauri:dev": "pnpm --filter @forge-wisper/desktop tauri dev",
    "tauri:dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "tauri:build": "pnpm --filter @forge-wisper/desktop tauri build",
    "build:macos": "cd apps/macOS && sh build.sh",
    "test": "cargo test --workspace"
  },
  "keywords": [
    "voice-to-text",
    "whisper",
    "tauri",
    "speech-to-text",
    "groq",
    "rust"
  ],
  "author": "Ali Zazan",
  "license": "MIT"
}
